# Settings of Build/Scripts/runTests.sh for this package
PACKAGE_NAME="typo3-themes/themes-gridelements"
TEST_NAMESPACE='KayStrobach\ThemesGridelements\Tests\'
# gridelements has no release for TYPO3 v14 yet
SUPPORTED_VERSIONS="12 13"
CORE_PACKAGES="core backend extbase fluid frontend install form"
DATABASE=sqlite

# themes: the clone next to this one, otherwise its branch on GitHub
EXTRA_REQUIRE=()
THEMES_PATH="$(cd "${EXTENSION_ROOT}/.." && pwd)/themes"
if [ -f "${THEMES_PATH}/composer.json" ]; then
    EXTRA_DOCKER_VOLUMES="-v ${THEMES_PATH}:/dependencies/themes"
    EXTRA_REPOSITORIES=('{"type": "path", "url": "/dependencies/themes", "options": {"symlink": true, "versions": {"typo3-themes/themes": "99.0.0"}}}')
else
    EXTRA_REPOSITORIES=('{"type": "vcs", "url": "https://github.com/typo3-themes/themes"}')
    EXTRA_REQUIRE+=('"typo3-themes/themes": "dev-typo3-12-13-14"')
fi
